# GeoKnight GIS demo environment.
# Copy this file to .env and replace every change-me value before starting.
#   make env
# does that for you and keeps the result on this computer only.
# Never commit .env.

# Public name used in certificates and in the addresses GeoServer advertises.
# Use localhost on a laptop. On a cloud VM, use the DNS name that points at the VM.
PUBLIC_HOST=localhost

# local = self-signed certificate created by scripts/tls-local.sh
# letsencrypt = keep the certificate already on disk (scripts/tls-certbot.sh).
# make up writes a self-signed file only when certs/server.crt is missing,
# or when TLS_MODE=local and that file is still a local certificate.
# It does not replace a Let's Encrypt certificate.
TLS_MODE=local
LETSENCRYPT_EMAIL=you@example.com
LETSENCRYPT_DOMAIN=

HTTP_PORT=80
HTTPS_PORT=443

# Published only on the loopback interface. The public enters through Nginx.
GEOSERVER_BIND=127.0.0.1
POSTGIS_BIND=127.0.0.1
GEOSERVER_PORT=8080
POSTGIS_PORT=5432

COMPOSE_PROJECT_NAME=geoknight

# GeoServer administrator. The username "admin" and the password "geoserver" are rejected.
GEOSERVER_ADMIN_USER=gkadmin
GEOSERVER_ADMIN_PASSWORD=change-me-geoserver-password

# Locks the GeoServer security configuration. This is separate from the admin login.
GEOSERVER_MASTER_PASSWORD=change-me-master-password

# Database. Reachable from GeoServer on the private Docker network, and from this
# computer at 127.0.0.1 only so the load script can run.
POSTGRES_USER=geoknight
POSTGRES_PASSWORD=change-me-database-password
POSTGRES_DB=geoknight

# Login GeoServer uses. This role is not the database owner. It can read the
# map tables and insert, update, and delete only restricted.editor_notes.
GEOSERVER_DB_USER=geoserver_app
GEOSERVER_DB_PASSWORD=change-me-geoserver-db-password

# Application users. Passwords must be at least 12 characters and must not contain "change-me".
VIEWER_USER=viewer
VIEWER_PASSWORD=change-me-viewer-password
ANALYST_USER=analyst
ANALYST_PASSWORD=change-me-analyst-password
EDITOR_USER=editor
EDITOR_PASSWORD=change-me-editor-password

# Dashboard login. The dashboard is also limited to approved networks by Nginx.
GRAFANA_ADMIN_USER=gkadmin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password

# Who may open the GeoServer admin pages and the dashboard.
# The Docker gateway (the browser on this computer) is always allowed.
# Containers that simulate visitors are always refused.
# Add a public IP here (for example 203.0.113.10/32) if you administer the VM from home.
ADMIN_ALLOW_CIDRS=10.0.0.0/8,192.168.0.0/16,172.16.0.0/12

# Optional Keycloak profile. Leave the placeholder in place unless you turn that profile on.
KEYCLOAK_ADMIN=kcadmin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-password

# Locust visitor simulation.
SIM_USERS=16
SIM_SPAWN_RATE=4
SIM_DURATION=2m

# Optional CA file for `make verify` and `make simulate`.
# Leave it empty to trust certs/ca.crt when TLS_MODE=local, or the system
# certificate store when TLS_MODE=letsencrypt.
VERIFY_CA=

# scripts/backup.sh retention. BACKUP_DIR empty means backups/ in this repo.
BACKUP_DIR=
BACKUP_RETENTION_DAYS=14
BACKUP_KEEP=14
