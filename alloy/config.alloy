// Ship Nginx JSON access lines to Loki and label the fields the dashboard groups by.
// Promtail is retired. Grafana Alloy is the supported collector.

logging {
  level  = "info"
  format = "logfmt"
}

local.file_match "nginx" {
  path_targets = [{
    __path__ = "/var/log/nginx/access.log",
    job      = "nginx",
  }]
}

loki.source.file "nginx" {
  targets    = local.file_match.nginx.targets
  forward_to = [loki.process.nginx.receiver]
}

loki.process "nginx" {
  forward_to = [loki.write.default.receiver]

  stage.json {
    expressions = {
      status  = "status",
      service = "service",
      layer   = "layer",
      cache   = "cache",
    }
  }

  stage.labels {
    values = {
      status  = "",
      service = "",
      layer   = "",
      cache   = "",
    }
  }
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
